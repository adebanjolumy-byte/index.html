<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gen Z Bank - Demo</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    background: #f4f5f9;
    color: #171717;
}

button {
    cursor: pointer;
}

.hidden {
    display: none !important;
}

/* ================= LOGO ================= */

.logo {
    text-align: center;
    font-size: 30px;
    font-weight: 900;
    letter-spacing: -1px;
    margin-bottom: 10px;
}

.logo span {
    color: #7c3aed;
}

/* ================= AUTH ================= */

.auth-container {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.auth-box {
    width: 100%;
    max-width: 430px;
    background: white;
    padding: 30px;
    border-radius: 24px;
    box-shadow: 0 15px 50px rgba(0,0,0,.08);
}

.demo-label {
    text-align: center;
    color: #7c3aed;
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 20px;
}

.auth-box h2 {
    text-align: center;
    margin-bottom: 25px;
}

input,
select {
    width: 100%;
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 12px;
    margin-bottom: 14px;
    font-size: 15px;
    outline: none;
}

input:focus,
select:focus {
    border-color: #7c3aed;
}

.primary-btn {
    width: 100%;
    border: none;
    padding: 15px;
    border-radius: 12px;
    background: #7c3aed;
    color: white;
    font-weight: bold;
    font-size: 15px;
}

.secondary-btn {
    width: 100%;
    border: none;
    padding: 14px;
    border-radius: 12px;
    background: #111827;
    color: white;
    font-weight: bold;
    margin-top: 10px;
}

.switch-text {
    text-align: center;
    margin-top: 20px;
    font-size: 14px;
}

.switch-text button {
    background: none;
    border: none;
    color: #7c3aed;
    font-weight: bold;
}

/* ================= APP ================= */

.app {
    min-height: 100vh;
}

.topbar {
    background: white;
    padding: 18px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #eee;
}

.topbar .logo {
    margin: 0;
    font-size: 22px;
}

.logout {
    background: #fee2e2;
    color: #dc2626;
    border: none;
    padding: 10px 15px;
    border-radius: 10px;
    font-weight: bold;
}

.container {
    max-width: 1100px;
    margin: auto;
    padding: 25px 20px 100px;
}

.welcome {
    margin-bottom: 20px;
}

.welcome h2 {
    margin-bottom: 5px;
}

/* ================= BALANCE ================= */

.balance-card {
    background: linear-gradient(135deg,#7c3aed,#ec4899);
    color: white;
    border-radius: 25px;
    padding: 30px;
    margin-bottom: 20px;
    box-shadow: 0 20px 40px rgba(124,58,237,.2);
}

.balance-card small {
    opacity: .85;
}

.balance {
    font-size: 40px;
    font-weight: 900;
    margin: 10px 0;
}

/* ================= ACTIONS ================= */

.actions {
    display: grid;
    grid-template-columns: repeat(2,1fr);
    gap: 15px;
    margin-bottom: 25px;
}

.action-btn {
    background: white;
    border: none;
    padding: 20px;
    border-radius: 18px;
    font-weight: bold;
    box-shadow: 0 5px 20px rgba(0,0,0,.05);
}

.action-btn:hover {
    transform: translateY(-2px);
}

/* ================= SUPPORT ================= */

.support {
    background: #111827;
    color: white;
    padding: 20px;
    border-radius: 18px;
    margin-bottom: 25px;
}

.whatsapp {
    display: inline-block;
    margin-top: 12px;
    background: #25D366;
    color: white;
    text-decoration: none;
    padding: 12px 18px;
    border-radius: 10px;
    font-weight: bold;
}

/* ================= TRANSACTIONS ================= */

.history {
    background: white;
    padding: 25px;
    border-radius: 20px;
}

.history h3 {
    margin-bottom: 15px;
}

.transaction {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
    border-bottom: 1px solid #eee;
}

.transaction:last-child {
    border-bottom: none;
}

.credit {
    color: #16a34a;
    font-weight: bold;
}

.debit {
    color: #dc2626;
    font-weight: bold;
}

/* ================= MODAL ================= */

.modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.6);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    z-index: 100;
}

.modal-box {
    background: white;
    width: 100%;
    max-width: 450px;
    border-radius: 22px;
    padding: 28px;
}

.modal-box h2 {
    margin-bottom: 15px;
}

.modal-box p {
    line-height: 1.6;
    color: #555;
    margin-bottom: 18px;
}

.close-btn {
    background: #eee;
    color: #111;
    border: none;
    width: 100%;
    padding: 14px;
    border-radius: 10px;
    margin-top: 10px;
    font-weight: bold;
}

/* ================= RECEIPT ================= */

.receipt {
    background: #fafafa;
    border: 1px dashed #bbb;
    padding: 20px;
    border-radius: 15px;
    margin: 15px 0;
}

.receipt div {
    display: flex;
    justify-content: space-between;
    padding: 7px 0;
}

.success {
    text-align: center;
    font-size: 20px;
    color: #16a34a;
    font-weight: bold;
    margin-bottom: 15px;
}

@media(max-width:600px) {
    .actions {
        grid-template-columns: 1fr 1fr;
    }

    .balance {
        font-size: 32px;
    }
}
</style>
</head>

<body>

<!-- ================= SIGN UP ================= -->

<section id="signupPage" class="auth-container">

<div class="auth-box">

<div class="logo">
GEN<span>Z</span> BANK
</div>

<div class="demo-label">
DEMO BANKING APPLICATION
</div>

<h2>Create Account</h2>

<input id="fullName" type="text" placeholder="FULL NAME">

<input id="phone" type="tel" placeholder="PHONE NUMBER">

<input id="email" type="email" placeholder="EMAIL ADDRESS">

<input id="signupPin" type="password"
       maxlength="6"
       inputmode="numeric"
       placeholder="6 DIGIT PIN">

<input id="transferPin" type="password"
       maxlength="4"
       inputmode="numeric"
       placeholder="4 DIGIT TRANSFER PIN">

<button class="primary-btn" onclick="signup()">
CREATE ACCOUNT
</button>

<div class="switch-text">
Already have an account?
<button onclick="showLogin()">Login</button>
</div>

</div>
</section>


<!-- ================= LOGIN ================= -->

<section id="loginPage" class="auth-container hidden">

<div class="auth-box">

<div class="logo">
GEN<span>Z</span> BANK
</div>

<div class="demo-label">
DEMO BANKING APPLICATION
</div>

<h2>Welcome Back</h2>

<input id="loginIdentity"
       type="text"
       placeholder="PHONE NUMBER OR EMAIL">

<input id="loginPin"
       type="password"
       maxlength="6"
       inputmode="numeric"
       placeholder="6 DIGIT PIN">

<button class="primary-btn" onclick="login()">
LOGIN
</button>

<div class="switch-text">
Don't have an account?
<button onclick="showSignup()">Sign Up</button>
</div>

</div>
</section>


<!-- ================= APP ================= -->

<section id="appPage" class="app hidden">

<header class="topbar">

<div class="logo">
GEN<span>Z</span> BANK
</div>

<button class="logout" onclick="logout()">
Logout
</button>

</header>

<div class="container">

<div class="welcome">
<h2 id="userGreeting">Welcome</h2>
<p>Your Gen Z Bank demo dashboard</p>
</div>


<!-- BALANCE -->

<div class="balance-card">

<small>AVAILABLE BALANCE</small>

<div class="balance">
₦<span id="balance">0.00</span>
</div>

<small id="accountNameDisplay"></small>

</div>


<!-- ACTION BUTTONS -->

<div class="actions">

<button class="action-btn" onclick="openTransfer()">
💸<br>
Transfer
</button>

<button class="action-btn" onclick="openDeposit()">
💰<br>
Deposit
</button>

<button class="action-btn" onclick="showHistory()">
📜<br>
Transaction History
</button>

<button class="action-btn" onclick="openSupport()">
💬<br>
Customer Care
</button>

</div>


<!-- SUPPORT -->

<div class="support">

<h3>Need Help?</h3>

<p>Chat with Gen Z Bank customer support.</p>

<a class="whatsapp"
   href="https://wa.me/2348036233499"
   target="_blank">
WhatsApp: 08036233499
</a>

</div>


<!-- HISTORY -->

<div class="history">

<h3>Recent Transactions</h3>

<div id="transactionList">
<p>No transactions yet.</p>
</div>

</div>

</div>
</section>


<!-- ================= WELCOME BONUS MODAL ================= -->

<div id="bonusModal" class="modal hidden">

<div class="modal-box">

<h2>Welcome to Gen Z Bank</h2>

<p>
You have been credited with a free
<strong>₦75,000</strong> demo welcome bonus.
</p>

<button class="primary-btn" onclick="acceptBonus()">
Click Here to Accept
</button>

</div>
</div>


<!-- ================= TRANSFER MODAL ================= -->

<div id="transferModal" class="modal hidden">

<div class="modal-box">

<h2>Transfer Money</h2>

<input id="accountNumber"
       maxlength="10"
       inputmode="numeric"
       placeholder="ACCOUNT NUMBER"
       oninput="lookupAccount()">

<select id="bankSelect">
<option value="">SELECT BANK</option>
</select>

<div id="accountVerification"
     style="background:#f4f4f4;padding:12px;border-radius:10px;margin-bottom:15px;">
Enter an account number to simulate account verification.
</div>

<button class="primary-btn"
        onclick="proceedTransfer()">
PROCEED
</button>

<button class="close-btn"
        onclick="closeTransfer()">
CANCEL
</button>

</div>
</div>


<!-- ================= TRANSFER DETAILS ================= -->

<div id="detailsModal" class="modal hidden">

<div class="modal-box">

<h2>Transfer Details</h2>

<div id="recipientDetails"></div>

<input id="amount"
       type="number"
       min="1"
       placeholder="AMOUNT">

<input id="narration"
       type="text"
       placeholder="NARRATION">

<button class="primary-btn"
        onclick="confirmTransfer()">
SEND
</button>

<button class="close-btn"
        onclick="closeDetails()">
CANCEL
</button>

</div>
</div>


<!-- ================= PIN MODAL ================= -->

<div id="pinModal" class="modal hidden">

<div class="modal-box">

<h2>Confirm Transfer</h2>

<p>
Please confirm that the account name and bank details
are correct before entering your 4-digit transfer PIN.
</p>

<div id="finalRecipient"
     style="background:#f4f4f4;padding:15px;border-radius:10px;margin-bottom:15px;">
</div>

<input id="confirmTransferPin"
       type="password"
       maxlength="4"
       inputmode="numeric"
       placeholder="4 DIGIT TRANSFER PIN">

<button class="primary-btn"
        onclick="sendMoney()">
CONFIRM & SEND
</button>

<button class="close-btn"
        onclick="closePin()">
CANCEL
</button>

</div>
</div>


<!-- ================= RECEIPT ================= -->

<div id="receiptModal" class="modal hidden">

<div class="modal-box">

<div class="success">
✓ Money Sent Successfully
</div>

<div id="receiptContent" class="receipt"></div>

<button class="primary-btn"
        onclick="printReceipt()">
PRINT RECEIPT
</button>

<button class="close-btn"
        onclick="closeReceipt()">
CLOSE
</button>

</div>
</div>


<!-- ================= DEPOSIT ================= -->

<div id="depositModal" class="modal hidden">

<div class="modal-box">

<h2>Account Upgrade Required</h2>

<p>
KINDLY UPGRADE YOUR ACCOUNT TO BE ABLE TO
DEPOSIT MONEY.
</p>

<p>
MESSAGE <strong>08036233499</strong>
TO UPGRADE YOUR ACCOUNT.
</p>

<a class="whatsapp"
   href="https://wa.me/2348036233499"
   target="_blank">
Chat on WhatsApp
</a>

<button class="close-btn"
        onclick="closeDeposit()">
CLOSE
</button>

</div>
</div>


<script>

/* ============================================
   NIGERIAN BANK LIST
============================================ */

const banks = [
"Access Bank",
"Citibank Nigeria",
"Ecobank Nigeria",
"Fidelity Bank",
"First Bank of Nigeria",
"First City Monument Bank (FCMB)",
"Globus Bank",
"Guaranty Trust Bank (GTBank)",
"Heritage Bank",
"Jaiz Bank",
"Keystone Bank",
"LOTUS Bank",
"Moniepoint",
"Opay",
"Palmpay",
"Polaris Bank",
"Premium Trust Bank",
"Providus Bank",
"Stanbic IBTC Bank",
"Standard Chartered Bank Nigeria",
"Sterling Bank",
"SunTrust Bank",
"Union Bank of Nigeria",
"United Bank for Africa (UBA)",
"Unity Bank",
"Wema Bank",
"Zenith Bank",
"Fidelity Bank",
"Parallex Bank",
"Optimus Bank",
"Nova Bank",
"Signature Bank",
"Titan Trust Bank",
"TAJ Bank",
"Coronation Merchant Bank",
"Globus Bank"
];

const bankSelect = document.getElementById("bankSelect");

banks.forEach(bank => {

    const option = document.createElement("option");

    option.value = bank;
    option.textContent = bank;

    bankSelect.appendChild(option);

});


/* ============================================
   DATA
============================================ */

let currentUser = null;
let transferData = {};


/* ============================================
   SIGN UP
============================================ */

function signup() {

    const name =
        document.getElementById("fullName").value.trim();

    const phone =
        document.getElementById("phone").value.trim();

    const email =
        document.getElementById("email").value.trim();

    const pin =
        document.getElementById("signupPin").value;

    const transferPin =
        document.getElementById("transferPin").value;


    if (!name || !phone || !email ||
        pin.length !== 6 ||
        transferPin.length !== 4) {

        alert(
            "Please complete all fields correctly."
        );

        return;
    }


    const user = {

        name,
        phone,
        email,
        pin,
        transferPin,

        balance: 0,

        bonusAccepted: false,

        lastDailyCredit: null,

        transactions: []

    };


    localStorage.setItem(
        "genZUser",
        JSON.stringify(user)
    );


    alert(
        "Account created successfully. Please login."
    );

    showLogin();

}


/* ============================================
   LOGIN
============================================ */

function login() {

    const identity =
        document.getElementById("loginIdentity")
        .value.trim();

    const pin =
        document.getElementById("loginPin").value;


    const stored =
        localStorage.getItem("genZUser");


    if (!stored) {

        alert(
            "No account found. Please sign up first."
        );

        return;
    }


    const user = JSON.parse(stored);


    if (
        (identity !== user.phone &&
         identity.toLowerCase() !== user.email.toLowerCase())
        ||
        pin !== user.pin
    ) {

        alert("Invalid login details.");

        return;
    }


    currentUser = user;

    showApp();

}


/* ============================================
   SHOW APP
============================================ */

function showApp() {

    document
        .getElementById("signupPage")
        .classList.add("hidden");

    document
        .getElementById("loginPage")
        .classList.add("hidden");

    document
        .getElementById("appPage")
        .classList.remove("hidden");


    document.getElementById("userGreeting")
        .textContent =
        "Hello, " + currentUser.name;


    document.getElementById("accountNameDisplay")
        .textContent =
        currentUser.name;


    updateBalance();

    renderTransactions();


    /* Welcome bonus */

    if (!currentUser.bonusAccepted) {

        setTimeout(() => {

            document
                .getElementById("bonusModal")
                .classList.remove("hidden");

        }, 500);

    }


    processDailyReward();

}


/* ============================================
   ₦75,000 WELCOME BONUS
============================================ */

function acceptBonus() {

    if (!currentUser.bonusAccepted) {

        currentUser.balance += 75000;

        currentUser.bonusAccepted = true;


        addTransaction(
            "Welcome Bonus",
            75000,
            "Free welcome credit"
        );

    }


    saveUser();

    updateBalance();

    document
        .getElementById("bonusModal")
        .classList.add("hidden");

}


/* ============================================
   DAILY ₦1,000 DEMO REWARD
============================================ */

function processDailyReward() {

    const today =
        new Date().toISOString().slice(0,10);


    if (currentUser.lastDailyCredit !== today) {

        currentUser.balance += 1000;

        currentUser.lastDailyCredit = today;


        addTransaction(
            "Daily Reward",
            1000,
            "Daily demo credit"
        );


        saveUser();

        updateBalance();

        renderTransactions();

    }

}


/* ============================================
   TRANSACTIONS
============================================ */

function addTransaction(
    description,
    amount,
    narration
) {

    currentUser.transactions.unshift({

        id: Date.now(),

        description,

        amount,

        narration,

        date:
            new Date().toLocaleString()

    });

}


function renderTransactions() {

    const list =
        document.getElementById("transactionList");


    if (!currentUser.transactions.length) {

        list.innerHTML =
            "<p>No transactions yet.</p>";

        return;

    }


    list.innerHTML =
        currentUser.transactions
        .map(tx => `

        <div class="transaction">

            <div>
                <strong>${tx.description}</strong>
                <br>
                <small>${tx.date}</small>
            </div>

            <span class="${tx.amount >= 0 ? 'credit':'debit'}">

                ${tx.amount >= 0 ? '+' : '-'}
                ₦${Math.abs(tx.amount).toLocaleString()}

            </span>

        </div>

        `)
        .join("");

}


function updateBalance() {

    document.getElementById("balance")
        .textContent =
        currentUser.balance.toLocaleString(
            undefined,
            {
                minimumFractionDigits: 2
            }
        );

}


function saveUser() {

    localStorage.setItem(
        "genZUser",
        JSON.stringify(currentUser)
    );

}


/* ============================================
   TRANSFER
============================================ */

function openTransfer() {

    document
        .getElementById("transferModal")
        .classList.remove("hidden");

}


function closeTransfer() {

    document
        .getElementById("transferModal")
        .classList.add("hidden");

}


function lookupAccount() {

    const account =
        document.getElementById("accountNumber")
        .value;


    const box =
        document.getElementById("accountVerification");


    if (account.length !== 10) {

        box.textContent =
            "Enter a 10-digit account number.";

        return;
    }


    const bank =
        document.getElementById("bankSelect").value;


    if (!bank) {

        box.textContent =
            "Please select a bank.";

        return;
    }


    /*
      DEMO ONLY:
      This does NOT contact a bank or verify
      a real account.
    */

    box.innerHTML = `
        <strong>DEMO ACCOUNT CONFIRMATION</strong><br><br>
        Account Number: ${account}<br>
        Bank: ${bank}<br>
        Account Name: Demo Recipient
    `;

}


function proceedTransfer() {

    const account =
        document.getElementById("accountNumber")
        .value;

    const bank =
        document.getElementById("bankSelect")
        .value;


    if (account.length !== 10 || !bank) {

        alert(
            "Enter a valid demo account number and select a bank."
        );

        return;
    }


    transferData = {

        account,

        bank,

        accountName: "Demo Recipient"

    };


    document
        .getElementById("transferModal")
        .classList.add("hidden");


    document
        .getElementById("recipientDetails")
        .innerHTML = `

        <div style="
        background:#f4f4f4;
        padding:15px;
        border-radius:10px;
        margin-bottom:15px;">

        <strong>Recipient</strong><br><br>

        Account Name:
        ${transferData.accountName}<br>

        Account Number:
        ${transferData.account}<br>

        Bank:
        ${transferData.bank}

        </div>

    `;


    document
        .getElementById("detailsModal")
        .classList.remove("hidden");

}


function closeDetails() {

    document
        .getElementById("detailsModal")
        .classList.add("hidden");

}


function confirmTransfer() {

    const amount =
        Number(
            document.getElementById("amount").value
        );

    const narration =
        document.getElementById("narration").value;


    if (!amount || amount <= 0) {

        alert("Enter a valid amount.");

        return;
    }


    if (amount > currentUser.balance) {

        alert(
            "Insufficient demo balance."
        );

        return;
    }


    transferData.amount = amount;

    transferData.narration =
        narration || "Transfer";


    document
        .getElementById("detailsModal")
        .classList.add("hidden");


    document
        .getElementById("finalRecipient")
        .innerHTML = `

        <strong>PLEASE CONFIRM RECIPIENT</strong>
        <br><br>

        ${transferData.accountName}<br>

        ${transferData.account}<br>

        ${transferData.bank}<br><br>

        Amount:
        ₦${amount.toLocaleString()}

    `;


    document
        .getElementById("pinModal")
        .classList.remove("hidden");

}


function closePin() {

    document
        .getElementById("pinModal")
        .classList.add("hidden");

}


/* ============================================
   SEND MONEY
============================================ */

function sendMoney() {

    const pin =
        document.getElementById(
            "confirmTransferPin"
        ).value;


    if (pin.length !== 4) {

        alert(
            "Enter your 4-digit transfer PIN."
        );

        return;
    }


    if (pin !== currentUser.transferPin) {

        alert(
            "Incorrect transfer PIN."
        );

        return;
    }


    /*
       DEMO TRANSFER ONLY
    */

    currentUser.balance -=
        transferData.amount;


    addTransaction(

        "Transfer to " +
        transferData.accountName,

        -transferData.amount,

        transferData.narration

    );


    saveUser();

    updateBalance();

    renderTransactions();


    document
        .getElementById("pinModal")
        .classList.add("hidden");


    document
        .getElementById("receiptContent")
        .innerHTML = `

        <div>
            <strong>Status</strong>
            <span>Successful</span>
        </div>

        <div>
            <strong>Recipient</strong>
            <span>${transferData.accountName}</span>
        </div>

        <div>
            <strong>Account</strong>
            <span>${transferData.account}</span>
        </div>

        <div>
            <strong>Bank</strong>
            <span>${transferData.bank}</span>
        </div>

        <div>
            <strong>Amount</strong>
            <span>₦${transferData.amount.toLocaleString()}</span>
        </div>

        <div>
            <strong>Narration</strong>
            <span>${transferData.narration}</span>
        </div>

        <div>
            <strong>Date</strong>
            <span>${new Date().toLocaleString()}</span>
        </div>

        `;


    document
        .getElementById("receiptModal")
        .classList.remove("hidden");

}


/* ============================================
   RECEIPT
============================================ */

function printReceipt() {

    const content =
        document.getElementById(
            "receiptContent"
        ).innerHTML;


    const printWindow =
        window.open("", "", "width=500,height=700");


    printWindow.document.write(`

        <html>

        <head>

        <title>Gen Z Bank Receipt</title>

        <style>

